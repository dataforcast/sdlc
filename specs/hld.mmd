flowchart LR

    USER(["👤 User"])

    subgraph REPO["🔀 Project repository"]
        direction LR

        FRONTEND["🖥️ Frontend"]

        subgraph BACKEND["🗄️ Backend"]
            direction LR

            API["⚙️ REST API<br/>(FastAPI)"]
            CORE["🛠️ Core Backend<br/>(Business logic)"]

            API -->|"invokes"| CORE
