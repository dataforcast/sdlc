{
  "permissions": {
    "allow": [
      "Bash(cat:*)", "Bash(ls:*)", "Bash(grep:*)", "Bash(find:*)",
      "Bash(head:*)", "Bash(tail:*)", "Bash(less:*)", "Bash(more:*)",
      "Bash(wc:*)", "Bash(sort:*)", "Bash(uniq:*)", "Bash(diff:*)",
      "Bash(stat:*)", "Bash(file:*)", "Bash(tree:*)", "Bash(du:*)",
      "Bash(ps:*)", "Bash(pwd)", "Bash(whoami)", "Bash(which:*)",
      "Bash(uname:*)", "Bash(echo:*)", "Bash(date:*)",
      "Bash(awk:*)", "Bash(sed:*)", "Bash(cut:*)", "Bash(tr:*)",
      "Bash(comm:*)", "Bash(fmt:*)", "Bash(fold:*)", "Bash(join:*)",
      "Bash(nl:*)", "Bash(od:*)", "Bash(paste:*)", "Bash(tac:*)",
      "Bash(xargs:*)", "Bash(basename:*)", "Bash(dirname:*)",
      "Bash(readlink:*)", "Bash(md5sum:*)", "Bash(sha1sum:*)",
      "Bash(sha256sum:*)", "Bash(shasum:*)", "Bash(sum:*)",

      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git show:*)", "Bash(git ls-tree:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git config user.email:*)",
      "Bash(git config user.name:*)", "Bash(git init)",

      "Bash(uv --version)", "Bash(uv add:*)", "Bash(uv sync:*)",
      "Bash(uv pip:*)", "Bash(uv run pytest:*)", "Bash(uv run python:*)",
      "Bash(uv run uvicorn:*)", "Bash(uvicorn:*)", "Bash(python3:*)",
      "Bash(python -c:*)", "Bash(python -m:*)",
      "Bash(npm create:*)", "Bash(npm install:*)", "Bash(npm run build:*)",
      "Bash(npm run lint:*)", "Bash(npm test:*)",
      "Bash(npm run api:generate:*)", "Bash(npx:*)",
      "Bash(pnpm install:*)", "Bash(pnpm run build:*)",
      "Bash(pnpm api:generate:*)", "Bash(node:*)", "Bash(tsx:*)",
      "Bash(pip list)",

      "Edit(.env.example)",
      "Edit(frontend/.env.example)",
      "Write(.env.example)",
      "Write(backend/.env)",
      "Write(backend/.env.example)",
      "Write(frontend/.env)",
      "Write(frontend/.env.example)"
    ],
    "ask": [
      "Bash(git reset:*)", "Bash(git rm:*)",
      "Bash(rm:*)", "Bash(mv:*)", "Bash(cp:*)", "Bash(chmod:*)",
      "Bash(mkdir:*)", "Bash(touch:*)",
      "Bash(kill:*)", "Bash(pkill:*)", "Bash(fuser:*)",
      "Bash(lsof:*)", "Bash(netstat:*)", "Bash(ss:*)", "Bash(nohup:*)",
      "Bash(curl:*)", "Bash(pip install:*)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)"
    ]
  }
